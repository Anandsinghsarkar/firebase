# Required admin dashboard credentials
ADMIN_KEY=replace_with_a_long_random_admin_password
JWT_SECRET=replace_with_a_long_random_secret

# Firebase Admin service account JSON, encoded as Base64.
# Keep this private. Never use NEXT_PUBLIC_ or expose it in browser code.
FIREBASE_CREDENTIALS_B64=base64_encoded_service_account_json

# Required only for Realtime Database browsing.
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
